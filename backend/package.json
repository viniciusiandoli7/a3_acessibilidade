{
  "name": "alerta-visual-backend",
  "version": "7.1.0",
  "description": "Backend de alertas com Arduino, telemetria e painel responsivo",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:arduino": "node server.js --serial=COM9",
    "start:celular": "node server.js --serial=COM9 --remoto --origens=https://*.vercel.app",
    "test": "node ../tests/backend-smoke.js",
    "test:ui": "node ../tests/ui-smoke.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
